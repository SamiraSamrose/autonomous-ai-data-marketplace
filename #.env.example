# Application Configuration
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4

# MNEE Token Configuration
MNEE_INITIAL_SUPPLY=1000000000
MNEE_DECIMALS=18
MNEE_PER_ETH=1000

# Marketplace Configuration
BASE_DATA_PRICE=10
STREAMING_RATE=0.001
MIN_STAKE_AMOUNT=100

# Discovery Service
VECTOR_EMBEDDING_DIM=384
MAX_SEARCH_RESULTS=20
SEMANTIC_SIMILARITY_THRESHOLD=0.60

# Quality Oracle
QUALITY_SCORE_THRESHOLD=0.80
TRY_BEFORE_BUY_SAMPLES=100

# Smart Contracts
ESCROW_TIMEOUT=3600
SLASHING_PENALTY=0.10

# Cross-Chain
SUPPORTED_CHAINS=ethereum,solana,polygon,arbitrum
BRIDGE_FEE_PERCENTAGE=0.003

# Database (Optional)
DATABASE_URL=postgresql://user:password@localhost:5432/marketplace
REDIS_URL=redis://localhost:6379/0

# API Keys (Optional)
ETHEREUM_RPC_URL=
INFURA_API_KEY=
ALCHEMY_API_KEY=

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/marketplace.log
